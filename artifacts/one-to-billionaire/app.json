{
  "expo": {
    "name": "$1 to Billionaire",
    "slug": "one-to-billionaire",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon_2.png",
    "scheme": "one-to-billionaire",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon_2.png",
      "resizeMode": "contain",
      "backgroundColor": "#050A05"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourcompany.onetobillionaire"
    },
    "android": {
      "package": "com.yourcompany.onetobillionaire",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon_2.png",
        "backgroundColor": "#050A05"
      }
    },
    "web": {
      "favicon": "./assets/images/icon_2.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
